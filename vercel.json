{
  "version": 2,
  "builds": [
    {
      "src": "frontend-angular/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/frontend-angular/browser" }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://your-backend-url.render.com/api/$1"
    },
    { "source": "/(.*)", "destination": "/frontend-angular/$1" }
  ]
}

